# Dépendances et sortie de build — le bundle web se régénère depuis le dépôt
# (node tools/build-app-www.mjs), il n'est jamais commité.
node_modules/
www/

# Copies du bundle posées par `cap sync` dans les projets natifs
ios/App/App/public/
ios/App/App/capacitor.config.json
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Produits de build natifs
ios/App/build/
ios/App/DerivedData/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml

# Secrets et certificats — jamais dans le dépôt (plan §5, critère 7)
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
.env
.env.*
