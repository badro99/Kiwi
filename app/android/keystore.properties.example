# Copier en keystore.properties (ignoré par Git) sur la machine qui signe.
# Chemin relatif à app/android/. La clé elle-même ne doit jamais entrer dans Git.
# Générer la clé une seule fois, la sauvegarder hors machine (coffre du propriétaire) :
#   keytool -genkeypair -v -keystore kiwi-pro-release.jks -alias kiwi-pro \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=kiwi-pro-release.jks
storePassword=
keyAlias=kiwi-pro
keyPassword=
