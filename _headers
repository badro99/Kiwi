# Cloudflare Pages headers.
#
# 1. The Open Graph images.
#
#    Next's metadata route emits `fr/opengraph-image` — a real 1200x630 PNG with
#    NO file extension. Static hosts derive Content-Type from the extension, so
#    without this rule the file goes out as application/octet-stream and every
#    scraper that fetches it (WhatsApp, Facebook, iMessage, Slack, Twitter)
#    silently drops the preview image. The link still shares; it just shares
#    naked. That matters more than usual here because the site's own demo CTA
#    is a wa.me link, so WhatsApp is the channel the page is most often pasted
#    into.
#
#    Kept as three explicit paths rather than a wildcard: `/*/opengraph-image`
#    would also match any future locale, which is the intent, but Pages matches
#    a bare `*` greedily across slashes and the explicit form is unambiguous.

/fr/opengraph-image
  Content-Type: image/png
/en/opengraph-image
  Content-Type: image/png
/ar/opengraph-image
  Content-Type: image/png
/es/opengraph-image
  Content-Type: image/png

# 2. Next's fingerprinted bundles.
#
#    Everything under `_next/static` carries a content hash in its filename, so
#    a given URL's bytes never change. Year-long immutable caching is the
#    contract that filename is making; without it the CDN revalidates 2 MB of
#    unchanged JavaScript on every visit.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# 3. Mutable assets must stay revalidated. Pages matches paths, not query
# strings: /assets/*?v=* cannot distinguish stamped and unstamped requests.
# The SW owns cache-first for exact stamped URLs. Do not freeze /assets/*:
# some of these same files are still loaded without stamps.
/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

# Vendored fonts and icons do not carry merchant data. Detach the inherited
# Cache-Control before assigning a new value (Pages joins duplicate headers).
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000
/assets/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000

# HTML keeps Pages default max-age=0, must-revalidate.
# The worker script must discover new deployments.
/kiwi-sw.js
  Cache-Control: public, max-age=0, must-revalidate

# 4. Link-only internal ticket board.
#
# The board is intentionally reachable without the account gate, but it must
# not be indexed or retained by browsers/proxies. Ticket JSON and images also
# send no-store from their Functions handlers.
/tickets
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive
/tickets.html
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

# 5. The connector consent screen (agent-connect.html).
#
# An owner approves an AI assistant's access to their books on this page. It
# must never render inside someone else's frame (a transparent overlay over
# « Autoriser » is the classic attack on consent screens), and it should not
# leak its query string (client id, PKCE challenge) to the next page.
/agent-connect
  Cache-Control: private, no-store
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
/agent-connect.html
  Cache-Control: private, no-store
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer

# Baseline hardening also applies when static requests bypass Functions.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
