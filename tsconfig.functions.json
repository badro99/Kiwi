{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2023",
      "webworker",
      "webworker.iterable"
    ],
    "types": [],
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "functions/**/*.js",
    "types/*.d.ts",
    "types/*.check.js"
  ]
}
