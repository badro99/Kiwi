{
  "name": "kiwi-pos",
  "version": "2.0.0",
  "private": true,
  "description": "Kiwi POS & Operating System for Moroccan Merchants",
  "scripts": {
    "test": "node tools/check.js",
    "check": "node tools/check.js",
    "check:fast": "node tools/check.js --fast",
    "check:changed": "node tools/check.js --changed",
    "check:full": "node tools/check.js",
    "typecheck": "node tools/typecheck-ratchet-test.mjs",
    "stamp": "node tools/bump-stamp.js",
    "dev": "npx wrangler pages dev .",
    "stack": "node tools/kiwi-local-stack.mjs --seed",
    "db:check": "node tools/d1-migrations.mjs",
    "db:draft": "node tools/d1-migrations.mjs --draft",
    "db:status": "npx wrangler d1 migrations list kiwi-sales --remote -c wrangler.d1.toml",
    "db:migrate": "npx wrangler d1 migrations apply kiwi-sales --remote -c wrangler.d1.toml",
    "load:validate": "node tools/load-test-suite-test.mjs",
    "load:prod:smoke": "KIWI_PROFILE=smoke k6 run tests/load/k6/production-readonly.js",
    "load:prod:baseline": "KIWI_PROFILE=baseline k6 run tests/load/k6/production-readonly.js",
    "load:local:smoke": "KIWI_PROFILE=smoke k6 run tests/load/k6/local-operations.js",
    "load:orderpro:smoke": "KIWI_PROFILE=smoke k6 run tests/load/k6/orderpro-pressure.js",
    "load:orderpro:pressure": "KIWI_PROFILE=pressure k6 run tests/load/k6/orderpro-pressure.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
