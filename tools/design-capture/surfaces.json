{"id":"kds.standalone-fixture","cluster":"kds","native":true,"devices":["iphone","ipad","desktop"],"title":"Standalone kitchen screen, synthetic tickets (fixture)","app":"cuisine","entry":"/kiwi-cuisine.html","boot":"none","steps":[{"do":"waitFor","selector":"#pair, #screen","timeout":15000,"any":true},{"do":"wait","ms":800},{"do":"eval","js":"document.getElementById('pair')&&document.getElementById('pair').classList.remove('on');const s=document.getElementById('screen');s.hidden=false;s.querySelectorAll('.stack').forEach((st,i)=>{st.innerHTML='<article class=\"tk\"><div class=\"tk-top\"><span class=\"tk-no\">Demo '+(i+1)+'</span><span class=\"tk-timer\">12:45</span></div><ul class=\"tk-items\"><li><span class=\"tk-q\">2x</span><span class=\"tk-n\">Tajine kefta<span class=\"tk-note\">no onion, synthetic ticket</span></span></li></ul><button class=\"tk-act act-ready\">Ready</button></article>'});return true"},{"do":"wait","ms":600}],"notes":"Production markup of kiwi-cuisine.html with its pairing gate hidden and three synthetic tickets injected. No pairing code is entered; the app needs a paired till to show real tickets."},
